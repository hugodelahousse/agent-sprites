<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentsprites.daemon</string>

    <key>Program</key>
    <string>__AGENTSPRITES_BIN__/agentsprites-daemon</string>

    <key>MachServices</key>
    <dict>
        <key>com.agentsprites.xpc</key>
        <true/>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__AGENTSPRITES_DIR__/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>__AGENTSPRITES_DIR__/daemon.error.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
